# === Local dev values below. See DEPLOYMENT.md at the repo root for the ===
# === exact Railway (backend) / Vercel (frontend) / Supabase (DB) values ===

# Database. Defaults to a local SQLite file (lism.db, gitignored) -- zero
# setup, and data survives restarts. In production (Railway), set this to
# your Supabase Postgres connection string instead, e.g.:
#   postgresql://postgres:PASSWORD@HOST:5432/postgres
# No code changes needed either way -- the store is plain SQLAlchemy.
DATABASE_URL=sqlite:///./lism.db

# Auth (JWT signing). Leave blank for local dev -- the backend generates a
# random secret at startup if this is unset or a known placeholder, so tokens
# are never signed with a predictable value. That generated secret does not
# survive a restart (all sessions are invalidated), which is fine for local
# dev but NOT acceptable for any real deployment: set this to a real random
# value there, e.g. `python -c "import secrets; print(secrets.token_hex(32))"`.
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# The session token is stored in an httpOnly cookie, not localStorage.
#
# Local dev (frontend/backend on the same "localhost", different ports):
#   COOKIE_SECURE=false
#   COOKIE_SAMESITE=lax
#
# Production (frontend on Vercel, backend on Railway -- two different
# domains, which browsers treat as cross-site):
#   COOKIE_SECURE=true
#   COOKIE_SAMESITE=none
# (SameSite=None cookies are rejected by browsers unless also Secure --
# Vercel/Railway both serve over HTTPS by default, so this is safe there.)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Frontend origin (used for CORS and generated student join links). Local
# dev: http://localhost:3000. Production: your Vercel deployment URL, e.g.
# https://your-app.vercel.app (must be the exact origin, no trailing slash).
FRONTEND_ORIGIN=http://localhost:3000

# Optional: enables real email verification / password reset delivery via
# SMTP. Without SMTP_HOST, those emails are logged to the backend console
# instead (with the verify/reset link included), so the flows still work
# end-to-end in local dev with no mail server.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@lism.local

# Optional: enables real AI activity generation. Without this, the AI
# generator falls back to a canned interactive HTML template.
OPENAI_API_KEY=

# Optional, unused by the app today: reserved for Supabase-specific features
# (Auth, Storage) beyond the plain Postgres connection DATABASE_URL already
# provides. Not needed just to point DATABASE_URL at a Supabase database.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
