# Auth (JWT signing). Leave blank for local dev -- the backend generates a
# random secret at startup if this is unset or a known placeholder, so tokens
# are never signed with a predictable value. That generated secret does not
# survive a restart (all sessions are invalidated), which is fine for local
# dev but NOT acceptable for any real deployment: set this to a real random
# value there, e.g. `python -c "import secrets; print(secrets.token_hex(32))"`.
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# The session token is stored in an httpOnly cookie, not localStorage. Set this
# to true once the app is served over HTTPS -- browsers silently drop `Secure`
# cookies over plain http, which is why it defaults to false for local dev.
COOKIE_SECURE=false

# Frontend origin (used for CORS and generated student join links)
FRONTEND_ORIGIN=http://localhost:3000

# Optional: enables real AI activity generation. Without this, the AI
# generator falls back to a canned interactive HTML template.
OPENAI_API_KEY=

# Optional: future real persistence. Unused until app/services/data_store.py
# is swapped for a Supabase-backed implementation (see db/supabase_schema.sql).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
